# storybook-addon-annotations fail-closed gate.
# 1. Secret scan on staged commits (trufflehog, graceful skip if absent).
# 2. Staged files: lint-staged (eslint --fix + prettier + oxlint anti-slop).
# 3. Full typecheck (script owned by the annotations build; tsc --noEmit).

if command -v trufflehog >/dev/null 2>&1; then
  trufflehog git file://. --since-commit HEAD --only-verified --fail --no-update || exit 1
else
  echo "warning: trufflehog not installed, skipping secret scan (brew install trufflehog)" >&2
fi

npx lint-staged || exit 1
npm run typecheck || exit 1
