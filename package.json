{
  "name": "@kylebrodeur/storybook-addon-annotations",
  "version": "0.1.0",
  "description": "Leave visual annotations and threaded comments on the Storybook canvas, anchored to components or text ranges.",
  "keywords": [
    "storybook",
    "storybook-addon",
    "storybook-annotations",
    "storybook-comments",
    "visual-review",
    "design-review",
    "component-review",
    "qa",
    "ui-review",
    "threaded-comments",
    "developer-tools",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kylebrodeur/storybook-addon-annotations.git"
  },
  "bugs": {
    "url": "https://github.com/kylebrodeur/storybook-addon-annotations/issues"
  },
  "homepage": "https://github.com/kylebrodeur/storybook-addon-annotations#readme",
  "license": "MIT",
  "author": "kylebrodeur",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manager": "./dist/manager.js",
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./blocks": {
      "types": "./dist/blocks.d.ts",
      "default": "./dist/blocks.js"
    },
    "./preset": "./dist/preset.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "storybook-annotations": "./scripts/storybook-annotations.ts"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/release-checklist.md",
    "docs/media/storybook-addon-header.png",
    "docs/media/storybook-addon-quick.mp4",
    "skills/**/*",
    "scripts/storybook-annotations.ts",
    "scripts/export-annotations.ts",
    "*.js",
    "*.d.ts"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "build": "tsup",
    "build:watch": "npm run build -- --watch",
    "eject-ts": "zx scripts/eject-typescript.js",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "prerelease": "zx scripts/prepublish-checks.js",
    "release": "npm run build && auto shipit",
    "start": "run-p build:watch \"storybook dev -p 6006 --quiet\"",
    "build-storybook": "storybook build",
    "storybook:init": "node --experimental-strip-types scripts/storybook-annotations.ts init",
    "storybook:add-docs": "node --experimental-strip-types scripts/storybook-annotations.ts add-docs",
    "storybook:add-example": "node --experimental-strip-types scripts/storybook-annotations.ts add-example",
    "export:docs": "node --experimental-strip-types scripts/export-annotations.ts",
    "lint:anti-slop": "oxlint -c oxlint.config.ts src",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@oxlint/plugins": "^1.85.0",
    "@storybook/addon-docs": "next",
    "@storybook/icons": "^2.0.0",
    "@storybook/react-vite": "next",
    "@types/node": "^20",
    "@types/react": "^18.2.65",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.7.0",
    "auto": "^11.3.0",
    "boxen": "^8.0.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "next",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.85.0",
    "prettier": "^3.6.2",
    "prompts": "^2.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "next",
    "ts-dedent": "^2.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.0.5",
    "zod": "^3.25.76",
    "zx": "^8.7.1"
  },
  "peerDependencies": {
    "storybook": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "managerEntries": [
      "src/manager.tsx"
    ],
    "previewEntries": [
      "src/preview.tsx",
      "src/index.ts",
      "src/blocks.tsx"
    ],
    "nodeEntries": [
      "src/preset.ts"
    ]
  },
  "storybook": {
    "displayName": "Annotations",
    "icon": "https://user-images.githubusercontent.com/321738/63501763-88dbf600-c4cc-11e9-96cd-94adadc2fd72.png"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "oxlint -c oxlint.config.ts"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee7415"
}
